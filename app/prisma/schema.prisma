generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ══════════════════════════════════════════════
//  CORE — Content OS
// ══════════════════════════════════════════════

model Channel {
  id        String    @id @default(cuid())
  name      String
  niche     String
  platform  String
  brandName String?
  avatarUrl String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contents  Content[]
}

model Trend {
  id         String    @id @default(cuid())
  title      String
  platform   String
  niche      String
  views      Int       @default(0)
  engagement Float     @default(0)
  sourceUrl  String?
  metadata   Json?
  detectedAt DateTime  @default(now())
  contents   Content[]
}

model Content {
  id           String     @id @default(cuid())
  title        String
  niche        String
  status       String     @default("idea")
  script       String?
  videoUrl     String?
  thumbnailUrl String?
  channel      Channel    @relation(fields: [channelId], references: [id])
  channelId    String
  trend        Trend?     @relation(fields: [trendId], references: [id])
  trendId      String?
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  analytics    Analytics?
}

model Analytics {
  id        String   @id @default(cuid())
  content   Content  @relation(fields: [contentId], references: [id])
  contentId String   @unique
  views     Int      @default(0)
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  retention Float    @default(0)
  ctr       Float    @default(0)
  revenue   Float    @default(0)
  fetchedAt DateTime @default(now())
}

// ══════════════════════════════════════════════
//  VIDEOAI STUDIO — AI Production Pipeline
// ══════════════════════════════════════════════

model Project {
  id             String        @id @default(cuid())
  name           String
  description    String?
  genre          String
  targetPlatform String
  totalEpisodes  Int           @default(0)
  status         ProjectStatus @default(PLANNING)
  bible          String?       @db.Text
  styleRefUrl    String?
  coverImageUrl  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  characters     Character[]
  episodes       Episode[]
  apiUsage       ApiUsage[]

  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  PRODUCTION
  PAUSED
  COMPLETED
}

model Character {
  id              String   @id @default(cuid())
  projectId       String
  name            String
  realInspiration String?
  description     String   @db.Text
  physicalProfile String?  @db.Text
  crefUrl         String?
  voiceId         String?
  voiceModel      String?
  voiceSettings   Json?
  approved        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes          Scene[]

  @@map("characters")
}

model Episode {
  id              String        @id @default(cuid())
  projectId       String
  season          Int           @default(1)
  number          Int
  title           String
  slug            String
  period          String?
  emotionalArc    String?
  keyRevelation   String?
  script          String?       @db.Text
  narrationText   String?       @db.Text
  status          EpisodeStatus @default(SCRIPTED)
  costEstimateUsd Decimal?      @db.Decimal(10, 4)
  costActualUsd   Decimal?      @db.Decimal(10, 4)
  finalVideoUrl   String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes          Scene[]
  assets          Asset[]
  productionJobs  ProductionJob[]
  apiUsage        ApiUsage[]

  @@unique([projectId, season, number])
  @@map("episodes")
}

enum EpisodeStatus {
  SCRIPTED
  IMAGES
  AUDIO
  ANIMATION
  ASSEMBLY
  DONE
  PUBLISHED
}

model Scene {
  id                 String      @id @default(cuid())
  episodeId          String
  characterId        String?
  number             Int
  name               String
  durationSeconds    Int         @default(5)
  description        String?     @db.Text
  frameAPrompt       String?     @db.Text
  frameBPrompt       String?     @db.Text
  frameAUrl          String?
  frameBUrl          String?
  motionPrompt       String?     @db.Text
  negativePrompt     String?     @db.Text
  videoStdUrl        String?
  videoProUrl        String?
  audioNarrationUrl  String?
  audioDialogueUrl   String?
  lipSyncEligible    Boolean     @default(false)
  lipSyncApplied     Boolean     @default(false)
  klingTaskId        String?
  klingLipSyncTaskId String?
  status             SceneStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  episode            Episode     @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  character          Character?  @relation(fields: [characterId], references: [id])

  @@unique([episodeId, number])
  @@map("scenes")
}

enum SceneStatus {
  PENDING
  IMAGES_GENERATING
  IMAGES_DONE
  AUDIO_GENERATING
  AUDIO_DONE
  ANIMATING
  ANIMATION_DONE
  DONE
}

model Asset {
  id              String    @id @default(cuid())
  episodeId       String?
  sceneId         String?
  type            AssetType
  provider        String
  url             String?
  localPath       String?
  sizeBytes       BigInt?
  durationSeconds Float?
  metadata        Json?
  createdAt       DateTime  @default(now())
  episode         Episode?  @relation(fields: [episodeId], references: [id])

  @@map("assets")
}

enum AssetType {
  IMAGE
  VIDEO_STD
  VIDEO_PRO
  AUDIO_NARRATION
  AUDIO_DIALOGUE
  AUDIO_SFX
  AUDIO_MIXED
  SRT
  FINAL_VIDEO
}

model ProductionJob {
  id           String    @id @default(cuid())
  episodeId    String
  type         JobType
  status       JobStatus @default(QUEUED)
  celeryTaskId String?
  progress     Int       @default(0)
  currentStep  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?   @db.Text
  metadata     Json?
  createdAt    DateTime  @default(now())
  episode      Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@map("production_jobs")
}

enum JobType {
  FULL_EPISODE
  GENERATE_SCRIPT
  GENERATE_IMAGES
  GENERATE_AUDIO
  ANIMATE_SCENE
  LIPSYNC_SCENE
  ASSEMBLE_EPISODE
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
  CANCELLED
}

model ApiUsage {
  id           String   @id @default(cuid())
  agent        String
  projectId    String?
  episodeId    String?
  provider     Provider
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  characters   Int      @default(0)
  credits      Int      @default(0)
  fastMinutes  Float    @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(10, 6)
  createdAt    DateTime @default(now())
  project      Project? @relation(fields: [projectId], references: [id])
  episode      Episode? @relation(fields: [episodeId], references: [id])

  @@index([provider])
  @@index([episodeId])
  @@index([createdAt])
  @@map("api_usage")
}

enum Provider {
  ANTHROPIC
  ELEVENLABS
  KLING
  MIDJOURNEY
}
