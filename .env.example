# ══════════════════════════════════════════════
#  VideoAI Studio — Environment Variables
#  Copy to .env and fill in your values.
#  NEVER commit .env to git.
# ══════════════════════════════════════════════

# ──────────────────────────────────────────
# Database
# ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://videoai:videoai_dev@localhost:5432/videoai
DIRECT_URL=postgresql://videoai:videoai_dev@localhost:5432/videoai

# ──────────────────────────────────────────
# Redis / Queue
# ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ──────────────────────────────────────────
# Anthropic — Claude API
# https://console.anthropic.com/
# ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=8192

# ──────────────────────────────────────────
# ElevenLabs — TTS / Voice
# https://elevenlabs.io/app/settings/api-keys
# ──────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
NARRATOR_VOICE_ID=          # voice_id of the approved narrator
DANILO_VOICE_ID=             # voice_id of Danilo Vasconcelos character

# ──────────────────────────────────────────
# Kling AI — Image to Video
# https://klingai.com/
# ──────────────────────────────────────────
KLING_API_KEY=
KLING_API_SECRET=
KLING_BASE_URL=https://api.klingai.com

# ──────────────────────────────────────────
# Midjourney (via webhook/Discord bot)
# No official API — configure your own proxy
# ──────────────────────────────────────────
MIDJOURNEY_WEBHOOK_URL=      # your MJ proxy endpoint
MIDJOURNEY_API_KEY=          # if using a third-party MJ API

# ──────────────────────────────────────────
# Storage — choose one driver
# ──────────────────────────────────────────
STORAGE_DRIVER=local         # local | s3 | gdrive
LOCAL_STORAGE_PATH=./storage

# Cloudflare R2 / AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=auto
AWS_S3_ENDPOINT_URL=         # for R2: https://<account>.r2.cloudflarestorage.com

# Google Drive
GDRIVE_CREDENTIALS_JSON=     # path to service account JSON file
GDRIVE_FOLDER_ID=            # root folder ID for media uploads

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
ENVIRONMENT=development      # development | production
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000

# ──────────────────────────────────────────
# Next.js (prefix NEXT_PUBLIC_ for browser)
# ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
